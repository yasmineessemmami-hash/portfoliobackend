{
  "info": {
    "name": "Portfolio Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        { "name": "Site Configurations", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/site/configurations" } },
        { "name": "Themes", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/site/configurations/get/themes" } },
        { "name": "Social Icons", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/ui/social-icons" } },
        { "name": "Icons", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/ui/icons" } },
        { "name": "Home Meta", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/home/meta" } },
        { "name": "About", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/about" } },
        { "name": "Services", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/services" } },
        { "name": "Projects", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/projects" } },
        { "name": "Skills", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/skills" } },
        { "name": "Skills CV Download", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/skills/cv/download" } },
        { "name": "Blog", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/blog" } },
        { "name": "Blog Article", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/blog/article/{{slug}}" } },
        { "name": "Blog Subscribe", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/blog/subscribe" } },
        { "name": "Blog Unsubscribe (POST)", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/blog/unsubscribe" } },
        { "name": "Blog Unsubscribe (GET)", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/blog/unsubscribe?email={{email}}" } },
        { "name": "FAQ", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/faq" } },
        { "name": "Contact", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/contact" } },
        { "name": "Contact Submit", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/contact/submit" } },
        { "name": "User Key Store", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/user" } },
        { "name": "App Key Store", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/app" } },
        { "name": "Replay Start", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/replay/start" } },
        { "name": "Replay Append", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/replay/append" } },
        { "name": "Meta Page", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/meta/pages/{{page}}" } }
      ]
    },
    {
      "name": "Admin Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin1@example.com\",\n  \"password\": \"password123\"\n}" },
            "url": "{{baseUrl}}/api/v1/admin/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "Update Full Name", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/site/configurations/update/full-name" } },
        { "name": "Update Contact Info", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/site/configurations/update/contact-information" } },
        { "name": "Add Social Link", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/site/configurations/add/social-links" } },
        { "name": "Update Social Link", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/site/configurations/update/social-links" } },
        { "name": "Delete Social Link", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/site/configurations/delete/social-links" } },
        { "name": "Order Social Links", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/site/configurations/order/social-links" } },
        { "name": "Theme Palette Update", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/site/configurations/theme-palette/update" } },
        { "name": "Theme Palette Restore Default", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/site/configurations/theme-palette/restore-default" } },
        { "name": "Theme Palette Create", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/site/configurations/theme-palette/create" } },
        { "name": "Theme Palette Activate", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/site/configurations/theme-palette/activate" } },
        { "name": "Event Theme Toggle", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/site/configurations/event-theme/toggle" } },
        { "name": "Maintenance Mode Toggle", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/site/configurations/maintenance-mode/toggle" } },
        { "name": "Home Hero Update", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/home/hero/update" } },
        { "name": "Home Featured Projects Update", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/home/featured-projects/update" } },
        { "name": "Home Featured Projects Delete", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/home/featured-projects/delete" } },
        { "name": "About Hero Update", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/about/hero/update" } },
        { "name": "About Stats Update", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/about/stats/update" } },
        { "name": "About Introduction Update", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/about/introduction/update" } },
